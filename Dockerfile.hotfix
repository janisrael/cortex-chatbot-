# Single-stage image for hotfix deploys (avoids multi-stage parent-ID failures on some hosts)
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-prod.txt .
ENV PATH=/root/.local/bin:$PATH
RUN pip install --no-cache-dir --user --no-warn-script-location \
    --use-deprecated=legacy-resolver -r requirements-prod.txt

COPY . .
COPY db_config.py /app/db_config.py
RUN mkdir -p uploads chroma_db config logs data

ENV PYTHONUNBUFFERED=1
ENV FLASK_APP=app.py
ENV FLASK_ENV=production

EXPOSE 6001
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:6001/health || exit 1

CMD ["python", "app.py"]