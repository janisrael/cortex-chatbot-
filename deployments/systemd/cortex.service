[Unit]
Description=Cortex Chatbot Application
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/cortex
EnvironmentFile=-/opt/cortex/.env
Environment="PATH=/opt/cortex/venv-prod/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_APP=app.py"
Environment="FLASK_ENV=production"
Environment="PORT=6001"
ExecStart=/opt/cortex/venv-prod/bin/gunicorn --bind 0.0.0.0:6001 --workers 2 --threads 2 --timeout 120 --access-logfile /opt/cortex/logs/access.log --error-logfile /opt/cortex/logs/error.log --log-level info app:app
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cortex

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cortex/uploads /opt/cortex/chroma_db /opt/cortex/data /opt/cortex/logs /opt/cortex/config /opt/cortex/users.db /opt/cortex/.cache

[Install]
WantedBy=multi-user.target








